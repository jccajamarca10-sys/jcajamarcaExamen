<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jcajamarcaExamen.Views.vLogin"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Spacing="10"
                             Padding="20">

            <Image Source="logo_gym.png"
                   HeightRequest="130"
                   HorizontalOptions="Center" />

            <Label Text="GIMNASIO - INICIO DE SESIÓN"
                   TextColor="Purple"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
           
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,2*"
                  RowSpacing="10"
                  ColumnSpacing="10">

                <Label Text="Usuario:"
                       Grid.Row="0" Grid.Column="0" />
                <Entry x:Name="txtUsuario"
                       Grid.Row="0" Grid.Column="1"
                       Placeholder="Ingrese el usuario" />

                <Label Text="Contraseña:"
                       Grid.Row="1" Grid.Column="0" />
                <Entry x:Name="txtContrasena"
                       Grid.Row="1" Grid.Column="1"
                       Placeholder="Ingrese la contraseña"
                       IsPassword="True" />

                <Button x:Name="btnIniciarSesion"
                        Grid.Row="2" Grid.Column="0"
                        Text="Iniciar sesión"
                        Clicked="btnIniciarSesion_Clicked" />
                <Button x:Name="btnAcercaDe"
                        Grid.Row="2" Grid.Column="1"
                        Text="Acerca de"
                        Clicked="btnAcercaDe_Clicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
