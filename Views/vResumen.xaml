<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jcajamarcaExamen.Views.vResumen"
             Title="Resumen">
    <ScrollView>
        <VerticalStackLayout Spacing="10"
                             Padding="20">

            <Label x:Name="lblUsuarioConectado" Style="{StaticResource estiloUsuarioConectado}" />

            <Label Text="RESUMEN"
                   TextColor="Blue"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!--Grid 9 filas x 2 columnas-->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="8"
                  ColumnSpacing="10">

                <Label Text="Nombre:" Grid.Row="0" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Apellido:" Grid.Row="1" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Edad:" Grid.Row="2" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Fecha de inicio:" Grid.Row="3" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblFechaInicio" Grid.Row="3" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Plan:" Grid.Row="4" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblPlan" Grid.Row="4" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Casillero:" Grid.Row="5" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblCasillero" Grid.Row="5" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Monto Inicial:" Grid.Row="6" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblMontoInicial" Grid.Row="6" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Pago mensual:" Grid.Row="7" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblPagoMensual" Grid.Row="7" Grid.Column="1" Style="{StaticResource estiloValor}" />

                <Label Text="Pago Total:" Grid.Row="8" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
                <Label x:Name="lblPagoTotal" Grid.Row="8" Grid.Column="1" Style="{StaticResource estiloValor}" />
            </Grid>

            <Button x:Name="btnExportar"
                    Text="Exportar a archivo de texto"
                    BackgroundColor="DarkOrange"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="btnExportar_Clicked" />

            <Button x:Name="btnCerrarSesion"
                    Text="Cerrar sesión"
                    Clicked="btnCerrarSesion_Clicked"
                    Style="{StaticResource estiloBotonPrincipal}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
